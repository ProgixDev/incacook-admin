# IncaCook Admin — environment variables
#
# Copy this file to `.env.local` and adjust the values for your setup:
#   cp .env.example .env.local
#
# Only NEXT_PUBLIC_* vars are read by the app (they are exposed to the browser).

# Base URL of the IncaCook backend (NestJS). The app appends `/v1` itself.
# Use an HTTPS origin for staging and production builds. Local development may
# use HTTP on localhost. Do not include a path (including `/v1`).
#
# Local IncaCook-Server:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
#
# Staging:
# NEXT_PUBLIC_API_BASE_URL=https://api-staging.incacook.com
# Production:
# NEXT_PUBLIC_API_BASE_URL=https://api.incacook.com

# For authenticated Playwright runs, this must match the API origin above.
# E2E_API_BASE_URL=http://127.0.0.1:3001
# Staging: E2E_API_BASE_URL=https://api-staging.incacook.com
# Staging-only admin test login: read email/password from Secret Manager
# (incacook-staging-admin-test-email / -password); never commit them.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
